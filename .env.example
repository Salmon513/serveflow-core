# ServeFlow — Environment Variables
# Copy to .env and fill in values before running the backend.

# ─── Application ────────────────────────────────────────────────────────────
PORT=3000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=serveflow
DB_USER=postgres
DB_PASSWORD=postgres
