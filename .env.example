# ServeFlow — Environment Variables
# Copy to .env and fill in values before running the backend.

# ─── Application ────────────────────────────────────────────────────────────
PORT=3000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=serveflow
DB_USER=postgres
DB_PASSWORD=postgres

# ─── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY='open_api_key'
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

GEMINI_API_KEY='gemini_api_key'
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000


AI_PROVIDER=gemini
GEMINI_API_KEY='gemini_api_key'
GEMINI_MODEL=gemini-2.5-flash